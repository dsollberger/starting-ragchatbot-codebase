{
  "name": "rag-chatbot-frontend-tooling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Code quality tooling for the frontend/ vanilla JS/HTML/CSS assets",
  "scripts": {
    "format": "prettier --write \"frontend/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"frontend/**/*.{js,css,html}\"",
    "lint": "eslint frontend/**/*.js",
    "lint:fix": "eslint frontend/**/*.js --fix",
    "quality": "npm run format:check && npm run lint"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "prettier": "^3.3.3"
  }
}
